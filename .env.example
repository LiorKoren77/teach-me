# Database (local docker default). Vercel injects the hosted URL as DATABASE_URL.
DATABASE_URL=postgresql://teachme:teachme@localhost:5433/teachme
TEST_DATABASE_URL=postgresql://teachme:teachme@localhost:5433/teachme_test

# Adapters. Values: anthropic|fake, voyage|fake, voyage|noop, local|vercel_blob|s3,
# inprocess|sqs|vercel_function
LLM_PROVIDER=anthropic
EMBEDDINGS_PROVIDER=voyage
RERANKER_PROVIDER=voyage
FILE_STORE=local
JOB_RUNNER=inprocess

# Provider credentials (never commit real values)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
BLOB_READ_WRITE_TOKEN=
AWS_REGION=eu-central-1
S3_BUCKET=
SQS_QUEUE_URL=

# Workload identity federation: instead of ANTHROPIC_API_KEY, the deployment presents the OIDC
# token it is handed per invocation and the SDK exchanges it for a short-lived access token.
# Leave all five unset to authenticate with the key. See "Deployment" in the README.
# Where the OIDC token comes from: none|vercel_oidc|file. `none` means use the API key.
IDENTITY_PROVIDER=none
# IDENTITY_PROVIDER=file: the file holding the token, re-read on every exchange.
# IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic/token
# The federation rule the token is exchanged against (Anthropic console).
# ANTHROPIC_FEDERATION_RULE_ID=
# The organization owning that rule; a raw UUID, not a tagged id.
# ANTHROPIC_ORGANIZATION_ID=
# The service account the minted token acts as.
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# The workspace the minted token is scoped to (`wrkspc_*`, or `default`).
# ANTHROPIC_WORKSPACE_ID=
# JOB_RUNNER=vercel_function: the function hands each job to another invocation of itself by
# posting to {SELF_BASE_URL}/api/jobs/run with this secret in the x-job-secret header. Generate
# one per deployment (`openssl rand -hex 32`); without it /api/jobs/run refuses every caller.
JOB_RUNNER_SECRET=
# Where that POST goes. Leave unset on Vercel: VERCEL_URL, which Vercel sets per deployment, is
# used as https://{VERCEL_URL}, so a preview calls its own preview rather than production.
# SELF_BASE_URL=
# VERCEL_URL=

# Models per call site
MODEL_READ_PAGES=claude-opus-5
MODEL_DETECT_LANGUAGE=claude-opus-5
MODEL_CONTEXTUALIZE=claude-opus-5
MODEL_GENERATION=claude-opus-5
MODEL_GRADER=claude-sonnet-5
MODEL_RELEVANCE_CHECK=claude-haiku-4-5
MODEL_REEXPLAIN=claude-opus-5
EMBEDDING_MODEL=voyage-4
RERANK_MODEL=rerank-2.5

# Paths for the local file store and local digest bundles
LOCAL_FILES_DIR=data/files
DIGEST_DIR=digest
WRITE_LOCAL_BUNDLE=true
BLOB_PREFIX=teach-me

# Limits. Lists are JSON.
ENABLED_LANGUAGES=["he","en","pt"]
MAX_PAGES_PER_SOURCE=400
# Largest file the admin upload route accepts, in bytes (50 MB). Vercel refuses a request
# body over 100 MB regardless.
MAX_UPLOAD_BYTES=52428800
# How many sources one admin may upload per hour, counted from the admin_actions audit trail.
# Per admin, not per deployment: it bounds what one account can spend on ingestion by mistake.
MAX_UPLOADS_PER_HOUR=20
# Pages per vision call. One read batch is one job invocation, so this multiplied by the
# per-page read latency has to fit the function's maxDuration - lower it for a slower model.
PAGES_PER_READ_BATCH=6
PAGES_PER_CHUNK_BATCH=6
# How long a job may sit `running` before `/api/jobs/run` (and `teachme jobs sweep`) calls its
# invocation dead and marks it failed so it can be retried. Set it to the function's maxDuration.
JOB_STALE_AFTER_SECONDS=300
# Learning loop: answer size, per-student answer rate, rejections before a question is
# scored wrong, and how many weak sections a re-explanation covers.
MAX_ANSWER_CHARS=1500
MAX_ANSWERS_PER_MINUTE=20
MAX_REJECTIONS_PER_QUESTION=2
REINFORCE_SECTIONS_CAP=3
# Relevance bands: at or above RELEVANCE_HIGH an answer skips the relevance check; below
# RELEVANCE_LOW it is LOW. Per-language overrides are JSON, keyed by language code.
RELEVANCE_HIGH=0.5
RELEVANCE_LOW=0.15
# Rendered subject corpora kept in the per-process cache, evicted least-recently-used first.
CORPUS_CACHE_MAX_ENTRIES=8
# RELEVANCE_THRESHOLDS={"he":{"high":0.4,"low":0.1}}
# Optional narrowing of accepted upload types, JSON list, e.g. ["application/pdf"]
# ALLOWED_UPLOAD_TYPES=
# Width in pixels a source page is rendered to for GET .../pages/{index}/image (64-2400).
THUMBNAIL_WIDTH=800

# Frontend (Next.js). Copy the pair from the Clerk dashboard into .env.local; the
# publishable key is public, the secret key never leaves .env.local or Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
# JWKS URL of the Clerk instance; without it every authenticated route answers 503.
CLERK_JWKS_URL=
# Optional: where Clerk sends a reader who has to sign in and where it returns them to. Unset
# (as here) means Clerk's own hosted pages and the page they came from, which is what this app
# uses - set these only after adding /sign-in and /sign-up routes of its own.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Where `next dev` sends /api/* . Unset means http://localhost:8000; on Vercel the
# Python function serves /api itself and no rewrite is applied.
# BACKEND_URL=http://localhost:8000
